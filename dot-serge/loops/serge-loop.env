# Loop-mode env for the serge wrapper — passed via SERGE_ENV_FILE by
# run-loop.sh, so it is loaded INSTEAD of serge.env. The wrapper sources this
# with `set -a`, and whatever it sets CLOBBERS env the caller exported — which
# is exactly why loop overrides live here and not in run-loop.sh exports.
#
# First pull in the real config/secrets, then flip the knobs unattended runs
# need. Per-loop LOOP_ENV lines are appended AFTER this file by run-loop.sh
# (into state/run.env), so they win over these defaults.

. "$HOME/.serge/serge.env"

# Loops self-correct: a typecheck/lint failure re-runs the turn instead of
# nudging a human who isn't there. (Interactive sessions keep nudge-only via
# serge.env's SERGE_VERIFY_ENFORCE=0.)
SERGE_VERIFY_ENFORCE=1
# Loops keep the soft full-test-suite pass (interactive serge.env turns it off
# for stop latency; unattended runs want the extra signal).
SERGE_VERIFY_TESTS=1
SERGE_REVIEW_ENFORCE=1

# Never let an unattended run kick off a surprise 10-task eval sweep as a Stop
# side effect (cost + recursion: the eval-gate loop runs the suite itself,
# deterministically). The PreToolUse constitution ratchet stays on.
SERGE_GATE_DISABLE=1

# Tighter runaway guard than the interactive 60.
SERGE_AUTOCONTINUE_CAP=25

# Loops are headless: don't burn the ~20/day cloud-brain classifier bucket on
# them, and never auto-escalate a loop turn to the vision/livefact seats.
SERGE_CLASSIFIER_MODEL=
