<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Serge model router (LiteLLM proxy) — macOS equivalent of serge-router.service.
     KeepAlive restarts it on any exit, like Restart=always. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.serge.router</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>set -a; [ -f __HOME__/.serge/router.env ] &amp;&amp; . __HOME__/.serge/router.env; set +a; exec __HOME__/.local/bin/litellm --config __HOME__/.serge/litellm.yaml --port 4000</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/opt/coreutils/libexec/gnubin:/opt/homebrew/bin:/usr/local/opt/coreutils/libexec/gnubin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/.serge/monitor/router.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.serge/monitor/router.log</string>
</dict>
</plist>
