<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Serge free-tier scanner — weekly probe for new/removed free models
     (macOS equivalent of serge-free-tier-scanner.timer; Mondays 09:30). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.serge.free-tier-scanner</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec __HOME__/.serge/free-tier-scanner.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/opt/coreutils/libexec/gnubin:/opt/homebrew/bin:/usr/local/opt/coreutils/libexec/gnubin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/.serge/monitor/free-tier-scanner.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.serge/monitor/free-tier-scanner.log</string>
</dict>
</plist>
