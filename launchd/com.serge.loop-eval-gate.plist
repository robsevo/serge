<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Serge autonomous loop: nightly eval gate (macOS equivalent of
     serge-loop@eval-gate.timer, 03:30). Loops need GNU tools on macOS:
     brew install coreutils flock   (see README "Platform support"). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.serge.loop-eval-gate</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec __HOME__/.serge/loops/run-loop.sh eval-gate</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>30</integer></dict>
  <key>Nice</key><integer>10</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/opt/coreutils/libexec/gnubin:/opt/homebrew/bin:/usr/local/opt/coreutils/libexec/gnubin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/.serge/loops/eval-gate/stderr.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.serge/loops/eval-gate/stderr.log</string>
</dict>
</plist>
